{
  "name": "legwork-school",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "test:e2e": "playwright test",
    "cloudflare:build": "node scripts/patch-iconv-cloudflare.mjs && node scripts/build-cloudflare.mjs",
    "cloudflare:dev": "npm run cloudflare:build && wrangler dev",
    "cloudflare:check": "npm run cloudflare:build && wrangler deploy --dry-run --outdir .wrangler/check",
    "cloudflare:deploy": "npm run cloudflare:build && wrangler deploy",
    "cloudflare:smoke": "npm run cloudflare:build && node scripts/cloudflare-smoke.mjs",
    "build": "npm run cloudflare:build",
    "postinstall": "node -e \"const fs=require('node:fs');if(fs.existsSync('scripts/build-cloudflare.mjs')&&fs.existsSync('server.js'))import('./scripts/build-cloudflare.mjs')\"",
    "cloudflare:staging:check": "npm run cloudflare:build && wrangler deploy --env staging --dry-run --outdir .wrangler/staging-check",
    "cloudflare:staging:deploy": "npm run cloudflare:build && wrangler deploy --env staging"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "express-rate-limit": "^7.5.0",
    "dotenv": "^16.4.7",
    "nodemailer": "^7.0.11",
    "pdfkit": "^0.20.2",
    "@fontsource/noto-sans": "^5.3.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "wrangler": "^4.166.0"
  }
}

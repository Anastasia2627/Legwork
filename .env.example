# Copy this file to .env for local use. Do not commit .env.
PORT=3000
NODE_ENV=development
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Choose a unique 12+ character password; never put a real value in GitHub.
ADMIN_PASSWORD=
DATABASE_PATH=./data/legwork.sqlite
SITE_ORIGIN=http://localhost:3000

# Payment integration is OFF until all values are provided.
PAYMENT_PROVIDER=disabled
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_SECRET_KEY=
# Required fixed store conversion rate (UAH per 1 USD), e.g. merchant-approved 42.50.
# Do not copy a sample rate into production: agree the actual rate first.
WAYFORPAY_UAH_PER_USD=
# Optional merchant domain approved in WayForPay cabinet.
WAYFORPAY_DOMAIN=
